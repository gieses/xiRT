include README.md CHANGELOG.md LICENCE pyproject.toml uv.lock mkdocs.yml
recursive-include docs *.md *.yaml *.png *.svg *.css
recursive-include examples *.py *.md *.csv *.json
prune examples/results
prune examples/__marimo__
recursive-include xirt/data_pipelines/benchmarks *.py
include .python-version pixi.toml pixi.lock
prune tests
prune benchmark
prune benchmarks
prune benchmark-tf-torch
prune benchmark-faims
prune documentation
global-exclude __pycache__ *.py[cod]
