include README.md CHANGELOG.md LICENCE NOTICE pyproject.toml uv.lock mkdocs.yml
include LICENSES/Apache-2.0.txt
recursive-include docs *.md *.yaml *.json *.png *.svg *.css
recursive-include examples *.py *.md *.csv *.json *.yaml
include xirt/assets/rp.pt xirt/assets/scx.pt xirt/assets/hsax.pt xirt/assets/multitask.pt xirt/assets/faims.pt xirt/assets/manifest.json
prune examples/results
prune examples/__marimo__
recursive-include xirt/data_pipelines/benchmarks *.py
include .python-version pixi.toml pixi.lock
prune tests
prune benchmark
prune benchmarks
prune benchmark-tf-torch
prune benchmark-faims
prune documentation
global-exclude __pycache__ *.py[cod]
